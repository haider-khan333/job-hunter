# Copy to .env and fill in. .env is gitignored and must never be committed,
# and a key must never be pasted into a chat, including a chat with the agent.
#
# This file is OPTIONAL. It only powers WhatsApp alerts from the hourly sweep
# (scripts/whatsapp.mjs). Without it you still get the Windows toast and
# applications/_watch/LATEST.md, which is enough for most people.

# ---- Meta WhatsApp Cloud API ---------------------------------------------
WHATSAPP_PROVIDER=meta

# The URL contains your PHONE NUMBER ID, which is NOT the phone number itself.
# Meta for Developers > your app > WhatsApp > API Setup, shown as
# "Phone number ID" under the From number. Paste it over <PHONE_NUMBER_ID>.
WHATSAPP_API_URL=https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages

# The access token. The one the dashboard shows you EXPIRES IN 24 HOURS, which
# is useless for an hourly job. You need a permanent System User token:
# business.facebook.com > Business settings > Users > System users > Add,
# assign the WhatsApp app, Generate token, scopes whatsapp_business_messaging
# and whatsapp_business_management, set to never expire.
WHATSAPP_API_KEY=

# Your own number, full international, digits only, no plus sign.
WHATSAPP_TO=

# Meta only delivers free-form text inside a 24-hour window that opens when YOU
# message the business number. Outside that window it fails SILENTLY and you
# need an approved template. Leave these blank to try free-form text first, and
# set them once a template is approved. The message body is passed as {{1}}.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
